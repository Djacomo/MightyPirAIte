#!/usr/bin/env bash
# =============================================================================
# MightyPirAIte — pre-commit hook
# Blocks .env files and secrets from being committed. Ever.
# =============================================================================
#
# INSTALL:
#   cp .github/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use the setup script:
#   ./cli/setup/setup.sh --hooks
# =============================================================================

set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

BLOCKED_PATTERNS=(
  "\.env$"
  "\.env\."
  "\.env\.local$"
  "\.env\.production$"
  "\.env\.staging$"
  "\.env\.development$"
  "\.env\.test$"
  "\.env\.example$"
  "secrets/"
  "credentials/"
  "\.pem$"
  "\.key$"
  "\.p12$"
  "\.pfx$"
  "\.cer$"
  "\.crt$"
  "config\.local\.json$"
)

STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || true)

if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

BLOCKED=()

for FILE in $STAGED_FILES; do
  for PATTERN in "${BLOCKED_PATTERNS[@]}"; do
    if echo "$FILE" | grep -qE "$PATTERN"; then
      BLOCKED+=("$FILE")
      break
    fi
  done
done

if [[ ${#BLOCKED[@]} -gt 0 ]]; then
  echo ""
  echo -e "${RED}⛔  COMMIT BLOCKED — secret or sensitive file detected${NC}"
  echo ""
  echo -e "${YELLOW}The following files must NEVER be committed:${NC}"
  for FILE in "${BLOCKED[@]}"; do
    echo "    ✗  $FILE"
  done
  echo ""
  echo "If this file contains placeholder values only (no real secrets),"
  echo "rename it using a safe convention:"
  echo ""
  echo "    .env            →  env.template"
  echo "    config.local    →  config.template.json"
  echo ""
  echo "Then add the real file to .gitignore and never commit it."
  echo ""
  exit 1
fi

exit 0
